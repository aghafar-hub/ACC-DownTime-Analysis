# Copy to .env.local for local work. Never commit real addresses.
# Web-app URL of the Apps Script backend (ends in /exec). Leave empty to run on demo data.
VITE_API_URL=
# Base path of the site. './' works for GitHub Pages sub-paths.
VITE_BASE=./
# Shown as a ribbon on test copies, e.g. TEST COPY
VITE_ENV_LABEL=
# Prefix for browser storage keys so test and live never share a login or cache
VITE_STORAGE_PREFIX=
