{
  "version": 1,
  "notes": [
    "Single source of truth for the database spreadsheet, the Apps Script backend and the TypeScript types.",
    "Timestamps are plain text 'YYYY-MM-DD HH:MM:SS.mmm' in plant-local time (no time zone). Dates are 'YYYY-MM-DD'.",
    "Date/timestamp columns must be formatted as Plain Text in the sheet so Google Sheets never converts them.",
    "Booleans are stored as TRUE/FALSE.",
    "Original upload text (code_raw, reason_raw) is always kept next to resolved ids."
  ],
  "tables": [
    {
      "name": "lines",
      "description": "Reporting lines taken from the downtime sheet.",
      "key": ["line_id"],
      "columns": [
        {"name": "line_id", "type": "text", "required": true, "description": "L.1 or L.2"},
        {"name": "name", "type": "text", "required": true, "description": "Display name"},
        {"name": "sort_order", "type": "int", "required": true, "description": "Display order"},
        {"name": "active", "type": "bool", "required": true, "description": "Shown in the app"}
      ]
    },
    {
      "name": "areas",
      "description": "Downtime areas (the EQUIPMENT column of the downtime sheet).",
      "key": ["area_id"],
      "columns": [
        {"name": "area_id", "type": "text", "required": true, "description": "As written in the downtime sheet: CR, RM.1, K.1 ..."},
        {"name": "name", "type": "text", "required": true, "description": "Display name"},
        {"name": "line_id", "type": "text", "required": true, "description": "References lines.line_id"},
        {"name": "sort_order", "type": "int", "required": true, "description": "Display order"},
        {"name": "active", "type": "bool", "required": true, "description": "Shown in the app"},
        {"name": "in_downtime_sheet", "type": "bool", "required": true, "description": "TRUE when the downtime sheet already uses this area as EQUIPMENT"},
        {"name": "notes", "type": "text", "required": false, "description": "Free note"}
      ]
    },
    {
      "name": "equipment",
      "description": "Equipment master. Seeded from the platform master plus codes found in the downtime lists.",
      "key": ["equipment_id"],
      "columns": [
        {"name": "equipment_id", "type": "text", "required": true, "description": "Equipment code, upper case, e.g. 131.ST200"},
        {"name": "description", "type": "text", "required": false, "description": ""},
        {"name": "equipment_type", "type": "text", "required": false, "description": "Supplied by the user later"},
        {"name": "criticality", "type": "text", "required": false, "description": "e.g. High, Medium"},
        {"name": "parent_id", "type": "text", "required": false, "description": "Parent equipment code, blank if none"},
        {"name": "status", "type": "enum", "required": true, "enum": ["Active", "Retired"], "description": ""},
        {"name": "origin", "type": "text", "required": false, "description": "Platform master / Added: downtime value list / Added: downtime events only / User"},
        {"name": "platform_plant_area", "type": "text", "required": false, "description": "Reference only"},
        {"name": "platform_main_area", "type": "text", "required": false, "description": "Reference only"},
        {"name": "platform_sub_area", "type": "text", "required": false, "description": "Reference only"},
        {"name": "needs_review", "type": "bool", "required": true, "description": "Description, criticality or area missing"},
        {"name": "review_note", "type": "text", "required": false, "description": ""},
        {"name": "created_at", "type": "timestamp", "required": false, "description": ""},
        {"name": "updated_at", "type": "timestamp", "required": false, "description": ""},
        {"name": "updated_by", "type": "text", "required": false, "description": "user_id"}
      ]
    },
    {
      "name": "equipment_areas",
      "description": "Which areas a code belongs to. A code may belong to several areas.",
      "key": ["equipment_id", "area_id"],
      "columns": [
        {"name": "equipment_id", "type": "text", "required": true, "description": "References equipment.equipment_id"},
        {"name": "area_id", "type": "text", "required": true, "description": "References areas.area_id"}
      ]
    },
    {
      "name": "equipment_aliases",
      "description": "Typos and retired codes mapped to the canonical code.",
      "key": ["alias"],
      "columns": [
        {"name": "alias", "type": "text", "required": true, "description": "Code as written (upper case, no spaces)"},
        {"name": "equipment_id", "type": "text", "required": true, "description": "Canonical code"},
        {"name": "reason", "type": "text", "required": false, "description": ""}
      ]
    },
    {
      "name": "classifications",
      "description": "Stoppage classifications.",
      "key": ["code"],
      "columns": [
        {"name": "code", "type": "text", "required": true, "description": "PRO, MEC, ELE, AUT, PL, CIR"},
        {"name": "name", "type": "text", "required": true, "description": "Production, Mechanical, ..."},
        {"name": "is_incident", "type": "bool", "required": true, "description": "TRUE for PRO, MEC, ELE, AUT (criticality INC)"},
        {"name": "sort_order", "type": "int", "required": true, "description": ""}
      ]
    },
    {
      "name": "reasons",
      "description": "Reasons listed per classification, kept exactly as in the downtime value list.",
      "key": ["reason_id"],
      "columns": [
        {"name": "reason_id", "type": "text", "required": true, "description": "R-<classification>-<order>, e.g. R-MEC-007"},
        {"name": "classification", "type": "text", "required": true, "description": "References classifications.code"},
        {"name": "text_as_listed", "type": "text", "required": true, "description": "Exactly as listed, including leading spaces"},
        {"name": "match_key", "type": "text", "required": true, "description": "Trimmed, single-spaced, lower-case copy used for matching"},
        {"name": "order_no", "type": "int", "required": true, "description": "Position in the original list"},
        {"name": "active", "type": "bool", "required": true, "description": ""}
      ]
    },
    {
      "name": "upload_batches",
      "description": "One row per upload.",
      "key": ["batch_id"],
      "columns": [
        {"name": "batch_id", "type": "text", "required": true, "description": "B-YYYYMMDD-HHMMSS-xxxx"},
        {"name": "uploaded_by", "type": "text", "required": true, "description": "user_id"},
        {"name": "uploaded_at", "type": "timestamp", "required": true, "description": ""},
        {"name": "file_name", "type": "text", "required": false, "description": ""},
        {"name": "file_hash", "type": "text", "required": false, "description": "SHA-256 of the file"},
        {"name": "rows_read", "type": "int", "required": true, "description": ""},
        {"name": "rows_added", "type": "int", "required": true, "description": ""},
        {"name": "rows_identical", "type": "int", "required": true, "description": ""},
        {"name": "rows_skipped", "type": "int", "required": true, "description": "Late rows the user chose to skip"},
        {"name": "warning_count", "type": "int", "required": true, "description": ""},
        {"name": "status", "type": "enum", "required": true, "enum": ["Started", "Completed", "Failed"], "description": ""}
      ]
    },
    {
      "name": "events",
      "description": "One row per downtime record (one row of the downtime sheet). Freq, criticality and is_failure are sheet values.",
      "key": ["event_id"],
      "columns": [
        {"name": "event_id", "type": "text", "required": true, "description": "EV- + first 16 hex characters of fingerprint"},
        {"name": "batch_id", "type": "text", "required": true, "description": "References upload_batches.batch_id"},
        {"name": "event_date", "type": "date", "required": true, "description": "DATE column of the sheet"},
        {"name": "line_id", "type": "text", "required": true, "description": "L.1 or L.2 (from the sheet's Line column)"},
        {"name": "area_id", "type": "text", "required": true, "description": "EQUIPMENT column"},
        {"name": "code_raw", "type": "text", "required": true, "description": "EQUIPMENT CODE as written"},
        {"name": "equipment_id", "type": "text", "required": false, "description": "Resolved canonical code; blank when N/A or unknown"},
        {"name": "is_area_level", "type": "bool", "required": true, "description": "TRUE when the code is N/A (whole area stopped)"},
        {"name": "stop_ts", "type": "timestamp", "required": true, "description": "Stop Time"},
        {"name": "start_ts", "type": "timestamp", "required": true, "description": "Start Time (restart)"},
        {"name": "duration_s", "type": "float", "required": true, "description": "start_ts minus stop_ts in seconds"},
        {"name": "freq", "type": "int", "required": true, "description": "1 = new event, 0 = continuation (sheet value)"},
        {"name": "classification", "type": "text", "required": true, "description": "PRO, MEC, ELE, AUT, PL, CIR (upper case)"},
        {"name": "criticality", "type": "enum", "required": true, "enum": ["INC", "NO_INC"], "description": "Sheet value"},
        {"name": "is_failure", "type": "bool", "required": true, "description": "Sheet value: Failure = YES"},
        {"name": "reason_raw", "type": "text", "required": false, "description": "REASON as written"},
        {"name": "reason_id", "type": "text", "required": false, "description": "Resolved reasons.reason_id, blank when unlisted"},
        {"name": "description", "type": "text", "required": false, "description": "DESCRIPTION column"},
        {"name": "source_file", "type": "text", "required": false, "description": ""},
        {"name": "source_row", "type": "int", "required": false, "description": "Row number in the downtime sheet"},
        {"name": "fingerprint", "type": "text", "required": true, "description": "SHA-256 hex of area|code|stop|start|occurrence (original upload values)"},
        {"name": "flags", "type": "text", "required": false, "description": "Comma-separated data-quality flags"},
        {"name": "edited", "type": "bool", "required": true, "description": "TRUE once edited in the app"},
        {"name": "is_void", "type": "bool", "required": true, "description": "TRUE when voided; excluded from analysis, kept for audit"},
        {"name": "created_at", "type": "timestamp", "required": true, "description": ""}
      ]
    },
    {
      "name": "event_edits",
      "description": "One row per changed field when an event is edited or voided in the app. Keeps the original value.",
      "key": ["edit_id"],
      "columns": [
        {"name": "edit_id", "type": "text", "required": true, "description": "ED-<timestamp>-<n>"},
        {"name": "event_id", "type": "text", "required": true, "description": "References events.event_id"},
        {"name": "edited_at", "type": "timestamp", "required": true, "description": ""},
        {"name": "edited_by", "type": "text", "required": true, "description": "user_id"},
        {"name": "field", "type": "text", "required": true, "description": "Column name, or 'is_void'"},
        {"name": "old_value", "type": "text", "required": false, "description": ""},
        {"name": "new_value", "type": "text", "required": false, "description": ""},
        {"name": "note", "type": "text", "required": false, "description": "Why the change was made"}
      ]
    },
    {
      "name": "upload_warnings",
      "description": "Warnings raised by an upload, with the user's decision.",
      "key": ["warning_id"],
      "columns": [
        {"name": "warning_id", "type": "text", "required": true, "description": "W-<batch>-<n>"},
        {"name": "batch_id", "type": "text", "required": true, "description": ""},
        {"name": "type", "type": "enum", "required": true, "enum": ["late_row", "changed_row", "missing_row", "unknown_code", "code_not_in_area", "unlisted_reason", "blank_reason", "end_before_start", "duration_mismatch", "orphan_continuation", "overlap_in_area", "placeholder_code", "edited_in_app", "missing_code", "missing_classification", "invalid_classification", "unknown_area", "line_mismatch", "late_month"], "description": ""},
        {"name": "source_row", "type": "int", "required": false, "description": "Row number in the uploaded sheet"},
        {"name": "event_id", "type": "text", "required": false, "description": ""},
        {"name": "detail", "type": "text", "required": false, "description": "Plain-English description with stored and uploaded values"},
        {"name": "resolution", "type": "enum", "required": false, "enum": ["added", "skipped", "kept_stored", "accepted"], "description": ""},
        {"name": "resolved_by", "type": "text", "required": false, "description": "user_id"}
      ]
    },
    {
      "name": "roles",
      "description": "User roles.",
      "key": ["role_id"],
      "columns": [
        {"name": "role_id", "type": "text", "required": true, "description": "ROLE-ADMIN, ROLE-MGR, ROLE-ENG, ROLE-VIEW"},
        {"name": "name", "type": "text", "required": true, "description": ""},
        {"name": "description", "type": "text", "required": false, "description": ""}
      ]
    },
    {
      "name": "users",
      "description": "App accounts. Created by an admin; empty in the delivered database (the first admin is created by the setup function).",
      "key": ["user_id"],
      "columns": [
        {"name": "user_id", "type": "text", "required": true, "description": "U-<random>"},
        {"name": "email", "type": "text", "required": true, "description": "Unique, lower case"},
        {"name": "display_name", "type": "text", "required": true, "description": ""},
        {"name": "role_id", "type": "text", "required": true, "description": "References roles.role_id"},
        {"name": "password_hash", "type": "text", "required": true, "description": ""},
        {"name": "password_salt", "type": "text", "required": true, "description": ""},
        {"name": "hash_rounds", "type": "int", "required": true, "description": "Iterations used for this hash"},
        {"name": "must_change", "type": "bool", "required": true, "description": "Forced change at next sign-in"},
        {"name": "active", "type": "bool", "required": true, "description": ""},
        {"name": "failed_attempts", "type": "int", "required": true, "description": ""},
        {"name": "locked_until", "type": "timestamp", "required": false, "description": "UTC ISO time until which sign-in is refused"},
        {"name": "created_at", "type": "timestamp", "required": true, "description": ""},
        {"name": "last_login_at", "type": "timestamp", "required": false, "description": ""},
        {"name": "created_by", "type": "text", "required": false, "description": "user_id or 'setup'"}
      ]
    },
    {
      "name": "tab_access",
      "description": "Tab level per role, with optional per-user overrides. A user override wins over the role.",
      "key": ["subject_type", "subject_id", "tab_id"],
      "columns": [
        {"name": "subject_type", "type": "enum", "required": true, "enum": ["role", "user"], "description": ""},
        {"name": "subject_id", "type": "text", "required": true, "description": "role_id or user_id"},
        {"name": "tab_id", "type": "enum", "required": true, "enum": ["overview", "pareto", "repeats", "reliability", "events", "upload", "master", "settings", "users"], "description": ""},
        {"name": "level", "type": "enum", "required": true, "enum": ["Hidden", "View", "Edit"], "description": ""}
      ]
    },
    {
      "name": "settings",
      "description": "Admin-adjustable settings.",
      "key": ["key"],
      "columns": [
        {"name": "key", "type": "text", "required": true, "description": ""},
        {"name": "value", "type": "text", "required": false, "description": ""},
        {"name": "description", "type": "text", "required": false, "description": ""},
        {"name": "updated_by", "type": "text", "required": false, "description": ""},
        {"name": "updated_at", "type": "timestamp", "required": false, "description": ""}
      ]
    },
    {
      "name": "audit_log",
      "description": "Append-only log of every change.",
      "key": [],
      "columns": [
        {"name": "at", "type": "timestamp", "required": true, "description": ""},
        {"name": "user_id", "type": "text", "required": false, "description": ""},
        {"name": "action", "type": "text", "required": true, "description": ""},
        {"name": "entity", "type": "text", "required": false, "description": ""},
        {"name": "entity_id", "type": "text", "required": false, "description": ""},
        {"name": "detail", "type": "text", "required": false, "description": "Plain-English description"}
      ]
    }
  ],
  "settingsDefaults": [
    {"key": "availability_basis", "value": "B", "description": "A calendar; B calendar minus planned (headline); C minus planned and circumstantial"},
    {"key": "scheduled_hours_per_day", "value": "24", "description": "Scheduled hours per area per day"},
    {"key": "scheduled_days_per_week", "value": "7", "description": "Scheduled days per week"},
    {"key": "repeat_min_events", "value": "2", "description": "Failure events needed to flag a repeated failure"},
    {"key": "repeat_window_days", "value": "30", "description": "Window for repeated failures, in days"},
    {"key": "duration_short_max_min", "value": "30", "description": "Stops up to this many minutes are Short"},
    {"key": "duration_long_min_min", "value": "120", "description": "Stops from this many minutes are Long"},
    {"key": "availability_target_pct", "value": "", "description": "Availability target, percent; blank = none"},
    {"key": "default_comparison", "value": "previous_period", "description": "previous_period | same_period_last_year"},
    {"key": "lockout_attempts", "value": "5", "description": "Failed sign-ins before a temporary lock"},
    {"key": "lockout_minutes", "value": "15", "description": "Length of the temporary lock"},
    {"key": "session_hours", "value": "12", "description": "Session length without 'Keep me signed in'"},
    {"key": "session_hours_keep", "value": "720", "description": "Session length with 'Keep me signed in'"},
    {"key": "min_password_length", "value": "10", "description": "Minimum password length"}
  ],
  "roleSeeds": [
    {"role_id": "ROLE-ADMIN", "name": "Admin", "description": "Everything, including users and settings"},
    {"role_id": "ROLE-MGR", "name": "Manager", "description": "Views dashboards and master data"},
    {"role_id": "ROLE-ENG", "name": "Engineer", "description": "Uploads data, edits events and master data"},
    {"role_id": "ROLE-VIEW", "name": "Viewer", "description": "Views dashboards; never edits"}
  ],
  "tabAccessDefaults": {
    "ROLE-ADMIN": {"overview": "Edit", "pareto": "Edit", "repeats": "Edit", "reliability": "Edit", "events": "Edit", "upload": "Edit", "master": "Edit", "settings": "Edit", "users": "Edit"},
    "ROLE-MGR":   {"overview": "View", "pareto": "View", "repeats": "View", "reliability": "View", "events": "View", "upload": "Hidden", "master": "View", "settings": "Hidden", "users": "Hidden"},
    "ROLE-ENG":   {"overview": "View", "pareto": "View", "repeats": "View", "reliability": "View", "events": "Edit", "upload": "Edit", "master": "Edit", "settings": "Hidden", "users": "Hidden"},
    "ROLE-VIEW":  {"overview": "View", "pareto": "View", "repeats": "View", "reliability": "View", "events": "View", "upload": "Hidden", "master": "Hidden", "settings": "Hidden", "users": "Hidden"}
  },
  "classificationSeeds": [
    {"code": "PRO", "name": "Production", "is_incident": true, "sort_order": 1},
    {"code": "MEC", "name": "Mechanical", "is_incident": true, "sort_order": 2},
    {"code": "ELE", "name": "Electrical", "is_incident": true, "sort_order": 3},
    {"code": "AUT", "name": "Automation", "is_incident": true, "sort_order": 4},
    {"code": "PL", "name": "Planned", "is_incident": false, "sort_order": 5},
    {"code": "CIR", "name": "Circumstantial", "is_incident": false, "sort_order": 6}
  ],
  "lineSeeds": [
    {"line_id": "L.1", "name": "Line 1", "sort_order": 1, "active": true},
    {"line_id": "L.2", "name": "Line 2", "sort_order": 2, "active": true}
  ],
  "areaSeeds": [
    {"area_id": "CR", "name": "Crusher", "line_id": "L.1", "sort_order": 1, "in_downtime_sheet": true},
    {"area_id": "RM.1", "name": "Raw Mill 1", "line_id": "L.1", "sort_order": 2, "in_downtime_sheet": true},
    {"area_id": "K.1", "name": "Kiln 1", "line_id": "L.1", "sort_order": 3, "in_downtime_sheet": true},
    {"area_id": "FM.1", "name": "Coal (fuel) Mill 1", "line_id": "L.1", "sort_order": 4, "in_downtime_sheet": true, "notes": "Name to be confirmed"},
    {"area_id": "HD", "name": "Hot Disc", "line_id": "L.1", "sort_order": 5, "in_downtime_sheet": true},
    {"area_id": "CM.1", "name": "Cement Mill 1", "line_id": "L.1", "sort_order": 6, "in_downtime_sheet": true},
    {"area_id": "CM.2", "name": "Cement Mill 2", "line_id": "L.1", "sort_order": 7, "in_downtime_sheet": true},
    {"area_id": "PK.1", "name": "Packing 1", "line_id": "L.1", "sort_order": 8, "in_downtime_sheet": false},
    {"area_id": "HY.1", "name": "Hydrogen (Line 1)", "line_id": "L.1", "sort_order": 9, "in_downtime_sheet": false},
    {"area_id": "RM.2", "name": "Raw Mill 2", "line_id": "L.2", "sort_order": 10, "in_downtime_sheet": true},
    {"area_id": "K.2", "name": "Kiln 2", "line_id": "L.2", "sort_order": 11, "in_downtime_sheet": true},
    {"area_id": "FM.2", "name": "Coal (fuel) Mill 2", "line_id": "L.2", "sort_order": 12, "in_downtime_sheet": true, "notes": "Name to be confirmed"},
    {"area_id": "AFR", "name": "AFR (old system)", "line_id": "L.2", "sort_order": 13, "in_downtime_sheet": true},
    {"area_id": "AFR new", "name": "AFR (new system)", "line_id": "L.2", "sort_order": 14, "in_downtime_sheet": true, "notes": "Equipment list to be supplied"},
    {"area_id": "SHR", "name": "AF Shredding", "line_id": "L.2", "sort_order": 15, "in_downtime_sheet": true},
    {"area_id": "CM.3", "name": "Cement Mill 3", "line_id": "L.2", "sort_order": 16, "in_downtime_sheet": true},
    {"area_id": "CM.4", "name": "Cement Mill 4", "line_id": "L.2", "sort_order": 17, "in_downtime_sheet": true},
    {"area_id": "PK.2", "name": "Packing 2", "line_id": "L.2", "sort_order": 18, "in_downtime_sheet": false},
    {"area_id": "HY.2", "name": "Hydrogen (Line 2)", "line_id": "L.2", "sort_order": 19, "in_downtime_sheet": false}
  ]
}
